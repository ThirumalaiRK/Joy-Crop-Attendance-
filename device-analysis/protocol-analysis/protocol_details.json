    "commandCode": "uint16 Little-Endian (Bytes 8-9)",
    "checksum": "uint16 Little-Endian (Bytes 10-11) 16-bit 1's complement sum",
    "sessionId": "uint16 Little-Endian (Bytes 12-13)",
    "replyId": "uint16 Little-Endian (Bytes 14-15)",
    "dataPayload": "Byte array from offset 16 onwards"
  },
