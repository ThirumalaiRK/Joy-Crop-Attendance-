# Supabase Cloud Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Biometric Engine (Cloud Fingerprint API)
NEXT_PUBLIC_MXFACE_SUBSCRIPTION_KEY=your-subscription-key
NEXT_PUBLIC_MXFACE_FINGER_URL=https://fingerprintapi.mxface.ai/api/FingerPrint
NEXT_PUBLIC_MXFACE_FACE_URL=https://api.mxface.ai/v1
NEXT_PUBLIC_MXFACE_DEVICE_CODE=your-device-code

# On-Premise Biometric Connector Gateway (Optional / Default: http://localhost:4000)
NEXT_PUBLIC_CONNECTOR_URL=http://localhost:4000
